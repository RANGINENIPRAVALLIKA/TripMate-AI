# ==============================================================================
# TripMate AI — Root .gitignore
# ==============================================================================

# Dependencies
node_modules/
frontend/node_modules/

# Build and distribution outputs
dist/
frontend/dist/
backend/target/

# Environment files and credentials (preserve example files)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

frontend/.env
frontend/.env.*
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
!frontend/.env.example

backend/.env
backend/.env.*
backend/.env.local
!backend/.env.example

# Local application configurations
application-local.properties
application-local.yml
application-local.yaml
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-local.yml
backend/src/main/resources/application-local.yaml

# Local media uploads and storage
backend/uploads/
uploads/

# IDE and editor files
.idea/
.vscode/
*.iml
*.iws
*.ipr
*.swp
*.swo
.project
.classpath
.settings/

# Operating system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Log and diagnostic files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
